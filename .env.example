# 可选：配置 Gemini 多模态视觉密钥（未配置时自动以演示模式运行，仍可完整编辑并导出 .xlsx）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# 可选：Turso 云端数据库（未配置时自动使用本地 SQLite WAL）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 可选：Backblaze B2 对象存储（用于保存批量转换后的 .xlsx / .zip 与可编辑 JSON）
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# 推荐配置：全站登录账号与密码（在 Vercel 生产环境必填，防止未授权消耗额度）
AUTH_USERNAME=admin
AUTH_PASSWORD=
# 可选：自定义 Token 签名密钥（不填时自动由账号密码安全派生）
AUTH_SECRET=
